{
  "name": "@dsh-tavern/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The single shared contract between dsh-tavern and dsh-group-chat: owner vocabulary, id charset, loud-reject error, and the context-seat seam.",
  "license": "MIT",
  "exports": {
    ".": {
