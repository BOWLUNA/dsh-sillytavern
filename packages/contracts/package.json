      "default": "./src/client-rpc.ts"
    },
    "./client-slots": {
      "types": "./src/client-slots.ts",
      "default": "./src/client-slots.ts"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
